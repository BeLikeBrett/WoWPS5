+/* PS5_VIDEOOUT_STATS=1: the swapchains' and the flip thread's steps, and every buffer's state. */
+static void
+videoout_trace(const char *what, const void *chain)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   if (!getenv("PS5_VIDEOOUT_STATS"))
+      return;
+   char states[VIDEOOUT_BUFFERS * 24 + 1];
+   int used = 0;
+   for (uint32_t i = 0; i < VIDEOOUT_BUFFERS; i++)
+      used += snprintf(states + used, sizeof(states) - used, " %u:%lld%s%s", i, (long long)out->buffer[i].argument,
+                       out->buffer[i].held ? "H" : "", out->buffer[i].pending ? "P" : "");
+   fprintf(stderr, "wsi/videoout: %s chain %p current %p queue %u flip %lld latest %d buffers%s\n", what, chain,
+           (void *)out->current, out->queue_count, (long long)out->flip_argument,
+           out->latest_valid ? (int)out->latest_buffer : -1, states);
+}
+
+/* Flip a buffer at the next vblank, under lock. */
+static void
+videoout_submit_locked(uint32_t buffer)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   const int64_t argument = out->flip_argument + 1;
+   const int result = sceVideoOutSubmitFlip(out->handle, (int32_t)buffer, PS5_VIDEO_OUT_FLIP_VSYNC, argument);
+   if (result == 0) {
+      out->flip_argument = argument;
+      out->buffer[buffer].argument = argument;
+   } else {
+      fprintf(stderr, "wsi/videoout: sceVideoOutSubmitFlip(%u) failed: 0x%08x\n", buffer, (unsigned)result);
+   }
+   out->buffer[buffer].pending = false;
+}
+
+/* MAILBOX: a frame that was finished while the flip before it had yet to show
+ * is flipped here, after the vblank that showed that one. VideoOut queues
+ * flips a vblank apart, so flipping it at once would be FIFO again. */
+static int
+videoout_latest_thread(void *data)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   for (;;) {
+      mtx_lock(&out->lock);
+      const int handle = out->opened ? out->handle : -1;
+      mtx_unlock(&out->lock);
+      if (handle < 0 || sceVideoOutWaitVblank(handle) != 0) {
+         os_time_sleep(5000);
+         continue;
+      }
+      mtx_lock(&out->lock);
+      /* The flip status follows the vblank by a moment. */
+      for (unsigned tries = 0; tries < 8 && out->latest_valid &&
+                               videoout_shown_argument_locked() < out->flip_argument; tries++) {
+         mtx_unlock(&out->lock);
+         os_time_sleep(200);
+         mtx_lock(&out->lock);
+      }
+      if (out->latest_valid && videoout_shown_argument_locked() >= out->flip_argument) {
+         videoout_submit_locked(out->latest_buffer);
+         out->latest_valid = false;
+      }
+      /* A buffer came off the screen at this vblank. */
+      cnd_broadcast(&out->changed);
+      mtx_unlock(&out->lock);
+   }
+   return 0;
+}
