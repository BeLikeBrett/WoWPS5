+static NTSTATUS enable(void *args)
+{
+#ifdef __PROSPERO__
+    extern void wowps5_gamepad_enable(int);
+    wowps5_gamepad_enable(*(BOOL *)args);
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+const unixlib_entry_t __wine_unix_call_funcs[] = { probe, get_state, vibrate, enable };
