+/***********************************************************************
+ *           is_host_page_closed
+ *
+ * A host page holds four Windows pages and has one protection. Wine gives it
+ * every access any of the four allows, which is right for nearly everything.
+ * It is wrong for an image whose pages are made inaccessible one at a time so
+ * that the first access to each raises an exception: a protected executable
+ * decrypts its code that way, page by page, and with the union of the
+ * protections the three pages beside a decrypted one are reached without the
+ * exception and run as they are.
+ *
+ * Such a host page is kept inaccessible instead, as long as one of its pages
+ * is inaccessible and none is writable (one being written, as when it is
+ * being decrypted, opens the host page). An access the program is entitled to
+ * then faults too, and virtual_handle_fault reports it as a read of the
+ * inaccessible page beside it: the program's handler makes that page
+ * accessible, the instruction runs again, and after at most three such
+ * exceptions the host page is whole. The program sees exceptions for pages it
+ * had not touched yet; a handler that makes pages accessible on demand cannot
+ * tell. Only images and executable views of sections are treated this way.
+ */
+static BOOL is_host_page_closed( const char *page )
+{
+    struct file_view *view;
+    BOOL closed = FALSE;
+    size_t i;
+
+    if (host_page_size == page_size) return FALSE;
+    for (i = 0; i < host_page_size; i += page_size)
+    {
+        BYTE vprot = get_page_vprot( page + i );
