+    }
+    else if (!S_ISDIR( st.st_mode )) fatal_error( "'%s' is not a directory\n", config_dir );
+
+    if (asprintf( &dosdevices, "%s/dosdevices", config_dir ) == -1) fatal_error( "out of memory\n" );
+    if (!mkdir( dosdevices, 0777 ))
+    {
+#ifdef __PROSPERO__
+        /* A title cannot create symbolic links, so drive C: is the directory itself
+         * and there is no Z: drive for the Unix root. */
+        if (asprintf( &path, "%s/c:", dosdevices ) == -1) fatal_error( "out of memory\n" );
+        if (mkdir( path, 0777 ) == -1) fatal_perror( "cannot create %s", path );
+        free( path );
+#else
+        if (asprintf( &path, "%s/drive_c", config_dir ) == -1) fatal_error( "out of memory\n" );
+        mkdir( path, 0777 );
+        free( path );
+        if (asprintf( &path, "%s/c:", dosdevices ) == -1) fatal_error( "out of memory\n" );
+        symlink( "../drive_c", path );
+        free( path );
+        if (asprintf( &path, "%s/z:", dosdevices ) == -1) fatal_error( "out of memory\n" );
+        symlink( "/", path );
+        free( path );
+#endif
+    }
+    else if (errno != EEXIST) fatal_perror( "cannot create %s", dosdevices );
