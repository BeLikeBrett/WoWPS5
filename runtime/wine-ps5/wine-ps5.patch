+pthread_mutex_t inproc_server_mutex = PTHREAD_MUTEX_INITIALIZER;
+int inproc_direct_ok;                      /* the main loop sleeps in epoll/kqueue: clients may run requests */
+static int inproc_wake_fd = -1;            /* written to wake the sleeping main loop */
+static timeout_t inproc_sleep_until;       /* monotonic time the main loop sleeps until, 0 when awake */
+static unsigned int poll_users_epoch;      /* bumped when poll users are removed or change events */
+
+static void inproc_wake_poll_event( struct fd *fd, int event )
+{
+    char buffer[64];
+
+    while (read( fd->unix_fd, buffer, sizeof(buffer) ) > 0);
