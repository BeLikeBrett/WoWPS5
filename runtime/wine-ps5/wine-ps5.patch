+/***********************************************************************
+ *           server_inproc_wait_exit
+ *
+ * Tell the server thread that the process is exiting and give it the time to
+ * save the registry: nothing else would, since it ends with the process.
+ * Only async-signal-safe calls, this runs on the way to _exit() too.
+ */
+void server_inproc_wait_exit(void)
+{
+    struct pollfd pfd;
+    int ret;
+
+    if (inproc_done_fd == -1) return;
+    pfd.fd = inproc_done_fd;
+    pfd.events = POLLIN;
+    inproc_done_fd = -1;
+    close( fd_socket );  /* the server sees its last client process go */
+    do ret = poll( &pfd, 1, INPROC_SERVER_EXIT_TIMEOUT );
+    while (ret == -1 && errno == EINTR);
+}
