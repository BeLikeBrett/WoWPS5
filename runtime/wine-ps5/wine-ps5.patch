+    if (!params->config_dir || params->config_dir[0] != '/')
+        fatal_error( "the in-process server needs the absolute path of the configuration directory\n" );
+    if (!(dir = strdup( params->config_dir ))) fatal_error( "out of memory\n" );
+    for (p = dir + strlen(dir); p > dir + 1; p--) if (p[-1] != '/') break;
+    *p = 0;
+
+    if ((config_dir_fd = open( dir, O_RDONLY )) == -1)
+        fatal_error( "open %s: %s\n", dir, strerror( errno ));
+    if (fstat( config_dir_fd, &st ) == -1)
+        fatal_error( "stat %s: %s\n", dir, strerror( errno ));
+    if (!S_ISDIR(st.st_mode)) fatal_error( "%s is not a directory\n", dir );
+    config_dir_path = dir;
+
+    if (params->nls_dir && !(inproc_nls_dir = strdup( params->nls_dir ))) fatal_error( "out of memory\n" );
+    inproc_thread_kill = params->thread_kill;
+
+    /* init the process tracing mechanism */
+    init_tracing_mechanism();
+    inproc_init_wake_pipe();
+}
+
+/* Requests a client thread may run itself: they act on sync objects and
+ * handles, and never sleep in the server (a wait that cannot be satisfied
+ * returns STATUS_PENDING, and the thread then sleeps on its wait pipe as
+ * usual). Their data is ntdll's own buffers, never the application's: the
+ * open requests of named objects, which carry the caller's name buffer, stay
+ * on the pipe. Everything else goes through the server thread. */
+static int is_direct_request( enum request req )
+{
+    switch (req)
+    {
+    case REQ_select:
+    case REQ_create_event:
+    case REQ_event_op:
+    case REQ_query_event:
+    case REQ_create_keyed_event:
+    case REQ_create_mutex:
+    case REQ_release_mutex:
+    case REQ_query_mutex:
+    case REQ_create_semaphore:
+    case REQ_release_semaphore:
+    case REQ_query_semaphore:
+    case REQ_close_handle:
+    case REQ_dup_handle:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+/* Take the server lock. Another client thread holds it for a microsecond or
+ * two, so spin briefly before sleeping, which costs a thread switch. */
+static void lock_server_for_client(void)
+{
+    int i;
+
+    for (i = 0; i < 200; i++)
+    {
+        if (!pthread_mutex_trylock( &inproc_server_mutex )) return;
+#if defined(__i386__) || defined(__x86_64__)
+        __asm__ __volatile__( "pause" );
+#endif
+    }
+    pthread_mutex_lock( &inproc_server_mutex );
+}
+
+/* Run a request on the calling thread, which is the client thread tid of
+ * this process, instead of sending it to the server thread through the
+ * request pipe and waiting for the reply pipe: two thread switches become a
+ * lock. The server thread holds the lock except while it sleeps. Returns 0
+ * with the reply in info, 1 when the request must go through the pipe
+ * instead, 2 when the server killed the thread (the pipe would have been
+ * closed). */
+int wine_server_call_direct( unsigned int tid, client_ptr_t teb, struct __server_request_info *info )
+{
+    enum request req = info->u.req.request_header.req;
+    data_size_t size = info->u.req.request_header.request_size, pos = 0;
+    union generic_reply reply;
+    struct thread *thread;
+    char data[4096];
+    unsigned int i;
+    int ret = 1;
+
+    if (!inproc_direct_ok || req >= REQ_NB_REQUESTS || !is_direct_request( req ) || size > sizeof(data)) return 1;
+    for (i = 0; i < info->data_count && i < __SERVER_MAX_DATA; i++)
+    {
+        if (info->data[i].size > size - pos) return 1;
+        memcpy( data + pos, info->data[i].ptr, info->data[i].size );
+        pos += info->data[i].size;
+    }
+    if (pos != size) return 1;
+
+    lock_server_for_client();
+    if (!inproc_direct_ok || !(thread = get_thread_from_id( tid )))
+    {
+        pthread_mutex_unlock( &inproc_server_mutex );
+        return 1;
+    }
+    /* a thread the server has not initialised, or has already killed, uses
+     * the pipe, which reports its death exactly as before */
+    if (thread->teb == teb && teb && thread->state != TERMINATED && thread->reply_fd &&
+        !thread->req_toread && !thread->reply_towrite && !thread->req_data)
+    {
+        set_current_time();
+        thread->req = info->u.req;
+        thread->req_data = size ? data : NULL;
+
+        current = thread;
+        current->reply_size = 0;
+        clear_error();
+        memset( &reply, 0, sizeof(reply) );
+        if (debug_level) trace_request();
+
+        req_handlers[req]( &current->req, &reply );
+
+        if (current && current->reply_fd)
+        {
+            reply.reply_header.error = current->error;
+            reply.reply_header.reply_size = current->reply_size;
+            if (debug_level) trace_reply( req, &reply );
+            if (current->reply_size) memcpy( info->reply_data, current->reply_data, current->reply_size );
+            free( current->reply_data );
+            current->reply_data = NULL;
+            info->u.reply = reply;
+            ret = 0;
+        }
+        else
+        {
+            if (current)
+            {
+                current->exit_code = 1;
+                kill_thread( current, 1 );  /* no way to continue without reply fd */
+            }
+            ret = 2;
+        }
+        current = NULL;
+        thread->req_data = NULL;
+    }
+    release_object( thread );
+    pthread_mutex_unlock( &inproc_server_mutex );
+    return ret;
+}
+
+/* adopt one end of a socketpair as the process socket of the first client, the way
+ * master_socket_poll_event() does for a connection it accepted */
+void adopt_inproc_client( int fd )
+{
+    struct process *process;
+    struct thread *thread = NULL;
+
+    if (fcntl( fd, F_SETFL, O_NONBLOCK ) == -1)
+        fatal_error( "client socket %d: %s\n", fd, strerror( errno ));
+    if ((process = create_process( fd, NULL, 0, NULL, NULL, NULL, 0, NULL )))
+    {
+        if ((thread = create_thread( -1, process, NULL ))) add_process_thread( process, thread );
+        release_object( process );
+    }
+    if (!thread) fatal_error( "could not create the client process (status %x)\n", get_error() );
+}
