+    if ((hkey = reg_create_key( NULL, key, (ptr - key) * sizeof(WCHAR), REG_OPTION_VOLATILE, NULL )))
+    {
+        if (loaded) set_reg_value( hkey, graphics_driverW, REG_SZ, libname, (wcslen( libname ) + 1) * sizeof(WCHAR) );
