+    for (i = 0; i < nb_inproc_threads; i++)
+    {
+        if (inproc_threads[i].tid != unix_tid) continue;
+        ret = pthread_kill( inproc_threads[i].pthread, sig );
+        break;
+    }
+    pthread_mutex_unlock( &inproc_threads_mutex );
+    if (!ret) return 0;
+    errno = ret;
