+
+static const struct fd_ops inproc_wake_fd_ops =
+{
+    NULL,                         /* get_poll_events */
+    inproc_wake_poll_event,       /* poll_event */
+};
+
+/* create the pipe that client threads write to wake the main loop */
+void inproc_init_wake_pipe(void)
+{
+    struct fd *fd;
+    int wake[2];
+
+    if (pipe( wake ) == -1) return;
+    fcntl( wake[0], F_SETFD, FD_CLOEXEC );
+    fcntl( wake[1], F_SETFD, FD_CLOEXEC );
+    fcntl( wake[0], F_SETFL, O_NONBLOCK );
+    fcntl( wake[1], F_SETFL, O_NONBLOCK );
+    if (!(fd = create_anonymous_fd( &inproc_wake_fd_ops, wake[0], NULL, 0 ))) { close( wake[1] ); return; }
+    set_fd_events( fd, POLLIN );
+    inproc_wake_fd = wake[1];
+}
+
+/* a client thread added a timeout: wake the main loop if it sleeps past it */
+static void inproc_timeout_added( abstime_t when )
+{
+    timeout_t deadline = when > 0 ? monotonic_time + (when - current_time) : -when;
+    char byte = 0;
+
+    if (deadline >= inproc_sleep_until) return;
+    inproc_sleep_until = 0;  /* one wake is enough */
+    if (inproc_wake_fd != -1) write( inproc_wake_fd, &byte, 1 );
+}
+
+/* the main loop goes to sleep: let client threads in */
+static unsigned int inproc_sleep( int timeout, const struct timespec *ts )
+{
+    unsigned int epoch;
+
+    if (timeout == -1) inproc_sleep_until = TIMEOUT_INFINITE;
+    else if (ts) inproc_sleep_until = monotonic_time + ts->tv_sec * TICKS_PER_SEC + ts->tv_nsec / 100;
+    else inproc_sleep_until = monotonic_time + (timeout_t)timeout * 10000;
+    epoch = poll_users_epoch;  /* read it before the clients get in */
+    pthread_mutex_unlock( &inproc_server_mutex );
+    return epoch;
+}
+
+/* the main loop wakes up; returns 0 when clients removed or changed poll
+ * users meanwhile, so the events just read may belong to other fds. They are
+ * level-triggered: the next wait reports again whatever is still pending. */
+static int inproc_wake( unsigned int epoch )
+{
+    pthread_mutex_lock( &inproc_server_mutex );
+    inproc_sleep_until = 0;
+    return epoch == poll_users_epoch;
+}
+
+/* the server leaves the main loop from a timeout callback (lock held) */
+void inproc_leave_main_loop(void)
+{
+    inproc_direct_ok = 0;
+    pthread_mutex_unlock( &inproc_server_mutex );
+}
