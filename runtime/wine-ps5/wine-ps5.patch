+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "config.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#include "winternl.h"
+
+#include "file.h"
+#include "process.h"
+#include "thread.h"
+#include "request.h"
+
+#ifdef USE_INPROC
+
+/* The one client process is this process, so ptrace cannot be used on it (a process
+ * cannot trace itself) and is not needed: its memory is our memory. It is still
+ * accessed through the kernel, by passing the client address to write() and read() on
+ * a pipe, so that an unmapped or protected address comes back as EFAULT instead of
+ * faulting the server thread. Page protections are honoured, unlike with ptrace. */
+
+#define PROBE_CHUNK 4096  /* <= PIPE_BUF multiples the pipe always has room for when empty */
+
+static int probe_pipe[2] = { -1, -1 };
+
+/* initialize the process tracing mechanism */
+void init_tracing_mechanism(void)
+{
+    if (pipe( probe_pipe ) == -1) fatal_error( "pipe: %s\n", strerror( errno ));
+    fcntl( probe_pipe[0], F_SETFL, O_NONBLOCK );
+    fcntl( probe_pipe[1], F_SETFL, O_NONBLOCK );
+    fcntl( probe_pipe[0], F_SETFD, FD_CLOEXEC );
+    fcntl( probe_pipe[1], F_SETFD, FD_CLOEXEC );
+}
+
+/* initialize the per-process tracing mechanism */
+void init_process_tracing( struct process *process )
+{
+}
+
+/* terminate the per-process tracing mechanism */
+void finish_process_tracing( struct process *process )
+{
+}
+
+/* send a Unix signal to a specific thread */
+int send_thread_signal( struct thread *thread, int sig )
+{
+    int ret = -1;
+
+    if (thread->unix_tid != -1)
+    {
+        /* the client owns the mapping from the tid it registered to a thread it can signal */
+        if (inproc_thread_kill) ret = inproc_thread_kill( thread->unix_tid, sig );
+        else errno = ENOSYS;
+    }
+    else errno = ESRCH;
+
+    if (ret == -1 && errno == ESRCH) /* thread got killed */
+    {
+        thread->unix_pid = -1;
+        thread->unix_tid = -1;
+    }
+    if (debug_level)
+    {
+        if (ret != -1) fprintf( stderr, "%04x: *sent signal* signal=%d\n", thread->id, sig );
+        else fprintf( stderr, "%04x: *signal %d not sent* %s\n", thread->id, sig, strerror( errno ));
+    }
+    return (ret != -1);
+}
+
+/* empty the probe pipe after a failed transfer */
+static void drain_probe_pipe(void)
+{
+    char buffer[PROBE_CHUNK];
+
+    while (read( probe_pipe[0], buffer, sizeof(buffer) ) > 0) /* nothing */;
+}
+
+/* check that the process is the one we live in */
+static int check_inproc_process( struct process *process )
+{
+    if (process->unix_pid == -1)
+    {
+        set_error( STATUS_PROCESS_IS_TERMINATING );
+        return 0;
+    }
+    if (process->unix_pid != getpid())  /* cannot happen: no other process can connect */
+    {
+        set_error( STATUS_NOT_SUPPORTED );
+        return 0;
+    }
+    return 1;
+}
+
+/* read data from a process memory space */
+int read_process_memory( struct process *process, client_ptr_t ptr, data_size_t size, char *dest )
+{
+    if (!check_inproc_process( process )) return 0;
+
+    if ((unsigned long)ptr != ptr)
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return 0;
+    }
+
+    while (size)
+    {
+        data_size_t chunk = min( size, PROBE_CHUNK );
+        ssize_t len = write( probe_pipe[1], (const void *)(unsigned long)ptr, chunk );
+
+        if (len <= 0)
+        {
+            if (len == -1 && errno == EINTR) continue;
+            if (len == -1 && errno == EFAULT) set_error( STATUS_PARTIAL_COPY );
+            else file_set_error();
+            return 0;
+        }
+        if (read( probe_pipe[0], dest, len ) != len)
+        {
+            set_error( STATUS_UNSUCCESSFUL );
+            drain_probe_pipe();
+            return 0;
+        }
+        ptr  += len;
+        dest += len;
+        size -= len;
+    }
+    return 1;
+}
+
+/* write data to a process memory space */
+int write_process_memory( struct process *process, client_ptr_t ptr, data_size_t size, const char *src,
+                          data_size_t *written )
+{
+    data_size_t done = 0;
+
+    if (written) *written = 0;
+    if (!check_inproc_process( process )) return 0;
+
+    if ((unsigned long)ptr != ptr)
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return 0;
+    }
+
+    while (done < size)
+    {
+        data_size_t chunk = min( size - done, PROBE_CHUNK );
+        ssize_t len = write( probe_pipe[1], src + done, chunk ), ret;
+
+        if (len <= 0)
+        {
+            if (len == -1 && errno == EINTR) continue;
+            file_set_error();
+            break;
+        }
+        ret = read( probe_pipe[0], (void *)(unsigned long)(ptr + done), len );
+        if (ret > 0) done += ret;
+        if (ret != len)
+        {
+            /* the kernel refused to store into the client pages (EFAULT), which also
+             * happens for pages the client keeps read-only for its own bookkeeping */
+            set_error( STATUS_PARTIAL_COPY );
+            drain_probe_pipe();
+            break;
+        }
+    }
+    if (written) *written = done;
+    return done == size;
+}
+
+/* initialize registers in new thread if necessary */
+void init_thread_context( struct thread *thread )
+{
+    thread->system_regs = 0;
+}
+
+/* retrieve the thread system registers */
+void get_thread_context( struct thread *thread, struct context_data *context, unsigned int flags )
+{
+    /* all other regs are handled on the client side */
+    assert( flags == SERVER_CTX_DEBUG_REGISTERS );
+
+    /* The debug registers of a thread can only be reached from another process, so
+     * set_thread_context() below never changes them and they keep the zeros every
+     * thread starts with: the caller has initialized them to 0 already. */
+    context->flags |= SERVER_CTX_DEBUG_REGISTERS;
+}
+
+/* set the thread system registers */
+void set_thread_context( struct thread *thread, const struct context_data *context, unsigned int flags )
+{
+    static const struct context_data zero;
+
+    /* all other regs are handled on the client side */
+    assert( flags == SERVER_CTX_DEBUG_REGISTERS );
+
+    /* writing back the values they already have changes nothing */
+    if (!memcmp( &context->debug, &zero.debug, sizeof(context->debug) )) return;
+
+    /* hardware breakpoints would need a tracer process */
+    set_error( STATUS_NOT_SUPPORTED );
+}
+
+#endif  /* USE_INPROC */
