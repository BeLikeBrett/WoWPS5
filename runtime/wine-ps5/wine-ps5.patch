+/* what explorer's initialize_display_settings() does: make the current modes the registry modes,
+ * which is what ChangeDisplaySettings( NULL ) restores */
+static void inproc_store_display_settings(void)
+{
+    DISPLAY_DEVICEW device = {.cb = sizeof(device)};
+    DWORD i = 0;
+
+    while (!NtUserEnumDisplayDevices( NULL, i++, &device, 0 ))
+    {
+        DEVMODEW devmode = {.dmSize = sizeof(devmode)};
+        UNICODE_STRING name;
+
+        RtlInitUnicodeString( &name, device.DeviceName );
+        if (!NtUserEnumDisplaySettings( &name, ENUM_CURRENT_SETTINGS, &devmode, 0 )) continue;
+        if (NtUserChangeDisplaySettings( &name, &devmode, 0, CDS_GLOBAL | CDS_UPDATEREGISTRY | CDS_NORESET, NULL ))
+            WARN( "failed to store the display settings of %s\n", debugstr_w(device.DeviceName) );
+    }
+}
