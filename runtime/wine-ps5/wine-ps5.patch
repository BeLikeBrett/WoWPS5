+/**********************************************************************
+ *		position_handler
+ *
+ * Where each thread is, for a program that has stopped making progress on the
+ * console, where no debugger attaches: WINEPS5_THREAD_POSITIONS=<seconds>
+ * prints it that long after the start, three times two seconds apart.
+ */
+#ifdef __PROSPERO__
+extern ssize_t wowps5_debug_write( const void *text, size_t length ) __attribute__((weak));
+#endif
+
+/* WINEPS5_PROFILE=<seconds>: the same signal, twenty times a second, counts
+ * where each thread is instead of printing it, and every <seconds> the most
+ * counted places are printed and the counts start again. A thread in Wine is
+ * counted at the address its call came from (which names the system call); a
+ * thread in the program at the 4 KiB page it is running in. Idle threads are
+ * counted too, in the wait they sit in: read the first thread's lines, or the
+ * lines of whichever thread the program names as its loader. */
+struct profile_place { LONG64 key; LONG count; };
+static struct profile_place profile_places[8192];
+static int profile_seconds;
+
+static void profile_count( unsigned int tid, int inside, ULONG64 address )
+{
+    LONG64 key = ((LONG64)(tid & 0xffff) << 48) | ((LONG64)(inside != 0) << 47) | (address & 0x7fffffffffffull);
+    unsigned int i, slot = (unsigned int)(((ULONG64)key * 0x9e3779b97f4a7c15ull) >> 51);
+
+    for (i = 0; i < 64; i++, slot = (slot + 1) % ARRAY_SIZE(profile_places))
+    {
+        LONG64 seen = profile_places[slot].key;
+        if (!seen) seen = InterlockedCompareExchange64( &profile_places[slot].key, key, 0 );
+        if (!seen || seen == key)
+        {
+            InterlockedIncrement( &profile_places[slot].count );
+            return;
+        }
+    }
+}
+
+static void position_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    ucontext_t *ucontext = sigcontext;
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame;
+    char line[160];
+    int len, inside;
+
+    if (!data || !data->teb) return;
+    frame = get_syscall_frame( data );
+    inside = is_inside_syscall( data, RSP_sig(ucontext) ) || is_inside_signal_stack( data, (void *)RSP_sig(ucontext) );
+    if (profile_seconds)
+    {
+        profile_count( data->tid, inside, inside ? (frame ? frame->rip : 0) : (RIP_sig(ucontext) & ~(ULONG64)0xfff) );
+        return;
+    }
+    len = snprintf( line, sizeof(line), "%04x: position %016lx stack %016lx %s %016lx\n", (int)data->tid,
+                    (long)RIP_sig(ucontext), (long)RSP_sig(ucontext),
+                    inside ? "in Wine, called from" : "in the program, its last call into Wine from",
+                    frame ? (long)frame->rip : 0 );
+#ifdef __PROSPERO__
+    if (wowps5_debug_write) wowps5_debug_write( line, len ); else
+#endif
+    write( 2, line, len );
+    /* what the program's stack holds above its call into Wine: return addresses among them */
+    if (inside && frame && frame->rsp && !(frame->rsp & 7))
+    {
+        const ULONG64 *stack = (const ULONG64 *)frame->rsp;
+        char text[1200];
+        int i, used = snprintf( text, sizeof(text), "%04x: stack", (int)data->tid );
+
+        for (i = 0; i < 96 && (ULONG_PTR)(stack + i + 1) <= (ULONG_PTR)data->teb->Tib.StackBase; i++)
+            if (stack[i] > 0x10000 && (stack[i] >> 32) && stack[i] < 0x1800000000 &&
+                (stack[i] < 0x1000000000 || stack[i] >= 0x1700000000) && used < (int)sizeof(text) - 20)
+                used += snprintf( text + used, sizeof(text) - used, " %lx", (long)stack[i] );
+        text[used++] = '\n';
+#ifdef __PROSPERO__
+        if (wowps5_debug_write) wowps5_debug_write( text, used ); else
+#endif
+        write( 2, text, used );
+    }
+}
+
+static void profile_write( const char *text, int len )
+{
+#ifdef __PROSPERO__
+    if (wowps5_debug_write) { wowps5_debug_write( text, len ); return; }
+#endif
+    write( 2, text, len );
+}
+
+extern LONG server_request_counts[2][REQ_NB_REQUESTS];
+extern int server_count_requests;
+
+static void *profile_thread( void *arg )
+{
+    static struct profile_place top[400];
+    char line[128];
+    unsigned int i, j, tick, round = 0;
+
+    server_count_requests = 1;
+    for (;;)
+    {
+        for (tick = 0; tick < profile_seconds * 20; tick++)
+        {
+            usleep( 50000 );
+            virtual_signal_threads( SIGURG );
+        }
+        memset( top, 0, sizeof(top) );
+        for (i = 0; i < ARRAY_SIZE(profile_places); i++)
+        {
+            struct profile_place place = profile_places[i];
+
+            profile_places[i].count = 0;
+            if (!place.key || !place.count) continue;
+            for (j = 0; j < ARRAY_SIZE(top) && top[j].count >= place.count; j++) {}
+            if (j == ARRAY_SIZE(top)) continue;
+            memmove( top + j + 1, top + j, (ARRAY_SIZE(top) - j - 1) * sizeof(*top) );
+            top[j] = place;
+        }
+        round++;
+        for (i = 0; i < 2; i++)
+            for (j = 0; j < REQ_NB_REQUESTS; j++)
+            {
+                LONG count = InterlockedExchange( &server_request_counts[i][j], 0 );
+                if (count) profile_write( line, snprintf( line, sizeof(line), "requests %u: %s %u %d\n", round,
+                                                          i ? "direct" : "server", j, (int)count ));
+            }
+        for (j = 0; j < ARRAY_SIZE(top) && top[j].count; j++)
+            profile_write( line, snprintf( line, sizeof(line), "profile %u: %04x %5d %s %012llx\n", round,
+                                           (unsigned int)((ULONG64)top[j].key >> 48), (int)top[j].count,
+                                           (top[j].key >> 47) & 1 ? "wine" : "code",
+                                           (unsigned long long)(top[j].key & 0x7fffffffffffull) ));
+    }
+    return NULL;
+}
+
+static void *position_thread( void *arg )
+{
+    int i;
+
+    sleep( atoi( arg ));
+    for (i = 0; i < 3; i++)
+    {
+        virtual_signal_threads( SIGURG );
+        sleep( 2 );
+    }
+    return NULL;
+}
