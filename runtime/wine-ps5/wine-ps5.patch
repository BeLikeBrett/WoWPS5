+
+    if (socketpair( AF_UNIX, SOCK_STREAM, 0, fds ) == -1) fatal_perror( "socketpair" );
+    if (pipe( done ) == -1) fatal_perror( "pipe" );
+    fcntl( fds[0], F_SETFD, FD_CLOEXEC );
+    fcntl( fds[1], F_SETFD, FD_CLOEXEC );
+    fcntl( done[0], F_SETFD, FD_CLOEXEC );
+    fcntl( done[1], F_SETFD, FD_CLOEXEC );
+
+    if (asprintf( &nls_dir, "%s/nls", build_dir ? build_dir : data_dir ) == -1) fatal_error( "out of memory\n" );
+
+    if ((p = getenv( "WINEPS5_SERVER_DIRECT" )) && !strcmp( p, "0" )) server_direct = 0;
+    inproc_params.client_fd   = fds[1];
+    inproc_params.debug_level = TRACE_ON(server) != 0;
+    inproc_params.config_dir  = config_dir;
+    inproc_params.nls_dir     = nls_dir;
+    inproc_params.thread_kill = inproc_thread_kill;
+    inproc_done_fd = done[0];
+
+    /* the server blocks all asynchronous signals on its thread; create the thread with
+     * them blocked already so that none is delivered to it before it gets there */
+    sigfillset( &sigset );
+    pthread_sigmask( SIG_BLOCK, &sigset, &old_sigset );
+    pthread_attr_init( &attr );
+    pthread_attr_setstacksize( &attr, INPROC_SERVER_STACK_SIZE );
+    ret = pthread_create( &thread, &attr, inproc_server_thread, (void *)(INT_PTR)done[1] );
+    pthread_attr_destroy( &attr );
+    pthread_sigmask( SIG_SETMASK, &old_sigset, NULL );
+    if (ret) fatal_error( "cannot create the server thread: %s\n", strerror( ret ));
+    pthread_detach( thread );
+    return fds[0];
+}
