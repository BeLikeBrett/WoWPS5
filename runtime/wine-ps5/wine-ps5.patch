+ * itself: a VK_KHR_display plane in the output's own mode, which is also what
+ * win32u reports as the display's (default_update_display_devices), as the
+ * console's native Vulkan titles create theirs. A program whose window is not that size gets a swapchain the
+ * host refuses or scales; a fullscreen one matches. Further surfaces, and any
+ * made when the display cannot be had, are headless as on other systems. */
+/* VK_KHR_display, which Wine's own Vulkan header leaves out (no Windows program sees it) */
+typedef UINT64 ps5_VkDisplayKHR, ps5_VkDisplayModeKHR;
+struct ps5_display_properties
+{
+    ps5_VkDisplayKHR display;
+    const char *displayName;
+    VkExtent2D physicalDimensions, physicalResolution;
+    VkFlags supportedTransforms;
+    VkBool32 planeReorderPossible, persistentContent;
+};
+struct ps5_display_mode_properties
+{
+    ps5_VkDisplayModeKHR displayMode;
+    struct { VkExtent2D visibleRegion; uint32_t refreshRate; } parameters;
+};
+struct ps5_display_plane_properties
+{
+    ps5_VkDisplayKHR currentDisplay;
+    uint32_t currentStackIndex;
+};
+struct ps5_display_plane_capabilities
+{
+    VkFlags supportedAlpha;
+    VkOffset2D minSrcPosition, maxSrcPosition;
+    VkExtent2D minSrcExtent, maxSrcExtent;
+    VkOffset2D minDstPosition, maxDstPosition;
+    VkExtent2D minDstExtent, maxDstExtent;
+};
+struct ps5_display_surface_create_info
+{
+    VkStructureType sType;  /* VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR */
+    const void *pNext;
+    VkFlags flags;
+    ps5_VkDisplayModeKHR displayMode;
+    uint32_t planeIndex, planeStackIndex;
+    VkSurfaceTransformFlagBitsKHR transform;
+    float globalAlpha;
+    VkFlags alphaMode;      /* opaque 1, global 2, per pixel 4 */
+    VkExtent2D imageExtent;
+};
+
+/* The mode of the console's output, asked of the driver once with an instance of
+ * its own (this runs while win32u builds its display list, before any program's
+ * instance exists). FALSE when the driver offers no display. */
+BOOL ps5_get_display_mode( UINT *width, UINT *height, UINT *frequency )
+{
+    static const char *const names[] = { "VK_KHR_surface", "VK_KHR_display" };
+    static UINT cached[3];
+    static LONG state;  /* 0 not asked, 1 known, 2 none */
+    VkInstanceCreateInfo create_info = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .enabledExtensionCount = 2,
+                                        .ppEnabledExtensionNames = names};
+    PFN_vkCreateInstance p_create = (void *)vk_icdGetInstanceProcAddr( NULL, "vkCreateInstance" );
+    struct ps5_display_mode_properties mode;
+    struct ps5_display_properties display;
+    VkPhysicalDevice device;
+    VkInstance host;
+    uint32_t count;
+
+    if (!state)
+    {
+        LONG found = 2;
+
+        if (p_create && !p_create( &create_info, NULL, &host ))
+        {
+            VkResult (VKAPI_CALL *p_devices)( VkInstance, uint32_t *, VkPhysicalDevice * ) =
+                (void *)vk_icdGetInstanceProcAddr( host, "vkEnumeratePhysicalDevices" );
+            VkResult (VKAPI_CALL *p_displays)( VkPhysicalDevice, uint32_t *, struct ps5_display_properties * ) =
+                (void *)vk_icdGetInstanceProcAddr( host, "vkGetPhysicalDeviceDisplayPropertiesKHR" );
+            VkResult (VKAPI_CALL *p_modes)( VkPhysicalDevice, ps5_VkDisplayKHR, uint32_t *, struct ps5_display_mode_properties * ) =
+                (void *)vk_icdGetInstanceProcAddr( host, "vkGetDisplayModePropertiesKHR" );
+            void (VKAPI_CALL *p_destroy)( VkInstance, const VkAllocationCallbacks * ) =
+                (void *)vk_icdGetInstanceProcAddr( host, "vkDestroyInstance" );
+
+            count = 1;
+            if (p_devices && p_displays && p_modes && p_devices( host, &count, &device ) >= 0 && count &&
+                (count = 1, p_displays( device, &count, &display ) >= 0) && count &&
+                (count = 1, p_modes( device, display.display, &count, &mode ) >= 0) && count)
+            {
+                cached[0] = mode.parameters.visibleRegion.width;
+                cached[1] = mode.parameters.visibleRegion.height;
+                cached[2] = (mode.parameters.refreshRate + 500) / 1000;
+                found = 1;
+            }
+            if (p_destroy) p_destroy( host, NULL );
+        }
+        InterlockedCompareExchange( &state, found, 0 );
+    }
+    if (state != 1) return FALSE;
+    *width = cached[0];
+    *height = cached[1];
+    *frequency = cached[2];
+    return TRUE;
+}
+
+static VkResult ps5_display_surface_create( const struct vulkan_instance *instance, VkSurfaceKHR *surface )
+{
+    VkInstance host = instance->host.instance;
+    VkResult (VKAPI_CALL *p_devices)( VkInstance, uint32_t *, VkPhysicalDevice * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkEnumeratePhysicalDevices" );
+    VkResult (VKAPI_CALL *p_displays)( VkPhysicalDevice, uint32_t *, struct ps5_display_properties * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkGetPhysicalDeviceDisplayPropertiesKHR" );
+    VkResult (VKAPI_CALL *p_planes)( VkPhysicalDevice, uint32_t *, struct ps5_display_plane_properties * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkGetPhysicalDeviceDisplayPlanePropertiesKHR" );
+    VkResult (VKAPI_CALL *p_modes)( VkPhysicalDevice, ps5_VkDisplayKHR, uint32_t *, struct ps5_display_mode_properties * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkGetDisplayModePropertiesKHR" );
+    VkResult (VKAPI_CALL *p_supported)( VkPhysicalDevice, uint32_t, uint32_t *, ps5_VkDisplayKHR * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkGetDisplayPlaneSupportedDisplaysKHR" );
+    VkResult (VKAPI_CALL *p_capabilities)( VkPhysicalDevice, ps5_VkDisplayModeKHR, uint32_t, struct ps5_display_plane_capabilities * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkGetDisplayPlaneCapabilitiesKHR" );
+    VkResult (VKAPI_CALL *p_create)( VkInstance, const struct ps5_display_surface_create_info *, const VkAllocationCallbacks *, VkSurfaceKHR * ) =
+        (void *)p_vkGetInstanceProcAddr( host, "vkCreateDisplayPlaneSurfaceKHR" );
+    struct ps5_display_surface_create_info create_info = {.sType = 1000002001};
+    struct ps5_display_plane_capabilities capabilities;
+    struct ps5_display_mode_properties modes[64];
+    struct ps5_display_plane_properties planes[16];
+    struct ps5_display_properties displays[4];
+    VkPhysicalDevice device;
+    uint32_t count, i, mode = 0, plane = ~0u;
+    VkResult res;
+
+    if (!p_devices || !p_displays || !p_planes || !p_modes || !p_supported || !p_capabilities || !p_create)
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+    if (InterlockedCompareExchange( &ps5_display_taken, 1, 0 )) return VK_ERROR_NATIVE_WINDOW_IN_USE_KHR;
+
+    count = 1;
+    if ((res = p_devices( host, &count, &device )) < 0 || !count) goto failed;
+    count = ARRAY_SIZE(displays);
+    if ((res = p_displays( device, &count, displays )) < 0 || !count) goto failed;
+    count = ARRAY_SIZE(modes);
+    if ((res = p_modes( device, displays[0].display, &count, modes )) < 0 || !count) goto failed;
+    for (i = 0; i < count; i++)
+        TRACE( "display mode %u: %ux%u at %u mHz\n", i, modes[i].parameters.visibleRegion.width,
+               modes[i].parameters.visibleRegion.height, modes[i].parameters.refreshRate );
+    /* the first mode, which is the one ps5_get_display_mode reports to Windows */
+    count = ARRAY_SIZE(planes);
+    if ((res = p_planes( device, &count, planes )) < 0 || !count) goto failed;
+    for (i = 0; i < count && plane == ~0u; i++)
+    {
+        ps5_VkDisplayKHR supported[4];
+        uint32_t j, supported_count = ARRAY_SIZE(supported);
+
+        if (p_supported( device, i, &supported_count, supported ) < 0) continue;
+        for (j = 0; j < supported_count; j++) if (supported[j] == displays[0].display) plane = i;
+    }
+    if (plane == ~0u) { res = VK_ERROR_INITIALIZATION_FAILED; goto failed; }
+    if ((res = p_capabilities( device, modes[mode].displayMode, plane, &capabilities )) < 0) goto failed;
+
+    create_info.displayMode = modes[mode].displayMode;
+    create_info.planeIndex = plane;
+    create_info.planeStackIndex = planes[plane].currentStackIndex;
+    create_info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    create_info.globalAlpha = 1.0f;
+    create_info.alphaMode = (capabilities.supportedAlpha & 1) ? 1 : (capabilities.supportedAlpha & 2) ? 2 : 4;
+    create_info.imageExtent = modes[mode].parameters.visibleRegion;
+    if ((res = p_create( host, &create_info, NULL, surface )) < 0) goto failed;
+    ps5_display_host_surface = *surface;
+    MESSAGE( "win32u: the console's display is this surface: %ux%u, mode %u, plane %u\n",
+             (unsigned int)create_info.imageExtent.width, (unsigned int)create_info.imageExtent.height, mode, plane );
+    return VK_SUCCESS;
+
+failed:
+    WARN( "no display surface, result %d\n", res );
+    InterlockedExchange( &ps5_display_taken, 0 );
+    return res < 0 ? res : VK_ERROR_INITIALIZATION_FAILED;
+}
+#endif
