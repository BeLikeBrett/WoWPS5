+/* what explorer's manage_desktop() does before its message loop; the calling thread owns the result */
+static HWND inproc_create_desktop(void)
+{
+    static const WCHAR desktopW[] = {'#','3','2','7','6','9',0};
+    static const WCHAR messageW[] = {'M','e','s','s','a','g','e',0};
+    UNICODE_STRING desktop_name = RTL_CONSTANT_STRING( desktopW ), message_name = RTL_CONSTANT_STRING( messageW );
+    LARGE_INTEGER now;
+    GUID guid;
+    HWND hwnd;
+
+    /* identifies this desktop's display device key; nothing but this session ever sees it */
+    NtQuerySystemTime( &now );
+    guid.Data1 = now.u.LowPart;
+    guid.Data2 = now.u.HighPart;
+    guid.Data3 = 0x4000 | (GetCurrentProcessId() & 0xfff);
+    memcpy( guid.Data4, "\x80WoWPS5", 8 );
+
+    inproc_load_graphics_driver( &guid );
+
+    hwnd = NtUserCreateWindowEx( 0, &desktop_name, NULL, NULL, WS_POPUP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN,
+                                 0, 0, 0, 0, 0, 0, 0, &guid, 0, NULL, NULL, FALSE );
+    if (!hwnd)
+    {
+        ERR_(win)( "failed to create the desktop window, error %u\n", RtlGetLastWin32Error() );
+        return 0;
+    }
+    /* the HWND_MESSAGE parent */
+    NtUserCreateWindowEx( 0, &message_name, NULL, NULL, WS_POPUP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN,
+                          0, 0, 100, 100, 0, 0, 0, NULL, 0, NULL, NULL, FALSE );
+
+    NtUserSetWindowPos( hwnd, 0, get_system_metrics( SM_XVIRTUALSCREEN ), get_system_metrics( SM_YVIRTUALSCREEN ),
+                        get_system_metrics( SM_CXVIRTUALSCREEN ), get_system_metrics( SM_CYVIRTUALSCREEN ),
+                        SWP_SHOWWINDOW );
+    NtUserClipCursor( NULL );
+    inproc_store_display_settings();
+    NtUserSetShellWindowEx( hwnd, hwnd );
+    TRACE_(win)( "desktop window %p owned by thread %04x\n", hwnd, GetCurrentThreadId() );
+    return hwnd;
+}
+
+/* entry of the desktop thread, through NtUserCallNoParam */
+ULONG_PTR inproc_desktop_thread(void)
+{
+    HWND hwnd = 0;
+    BOOL owner;
+    MSG msg;
+    int ret;
+
+    if (!inproc_desktop_event) return 0;  /* not the thread start_inproc_desktop() created */
+
+    pthread_mutex_lock( &inproc_desktop_mutex );
+    /* a thread holding the loader lock may have made the desktop while this one was starting */
+    if ((owner = !inproc_desktop_tid))
+    {
+        inproc_desktop_tid = GetCurrentThreadId();
+        hwnd = inproc_create_desktop();
+    }
+    pthread_mutex_unlock( &inproc_desktop_mutex );
+    NtSetEvent( inproc_desktop_event, NULL );
+    if (!hwnd) return !owner;
+
+    while ((ret = NtUserGetMessage( &msg, 0, 0, 0 )) != -1)
+    {
+        if (!ret) continue;  /* a stray WM_QUIT: the desktop lives as long as the process */
+        /* the server posts WM_CLOSE when this is the last thread left, as it tells explorer to quit */
+        if (msg.hwnd == hwnd && msg.message == WM_CLOSE) break;
+        NtUserDispatchMessage( &msg );
+    }
+    TRACE_(win)( "desktop thread exiting\n" );
+    return 0;
+}
+
+/* create the desktop thread; inproc_desktop_mutex is held */
+static void create_inproc_desktop_thread(void)
+{
+    OBJECT_ATTRIBUTES attr = {.Length = sizeof(attr)};
+    HANDLE thread;
+    NTSTATUS status;
+    void *entry;
+
+    if ((status = NtCreateEvent( &inproc_desktop_event, EVENT_ALL_ACCESS, &attr, NotificationEvent, FALSE )))
+    {
+        ERR_(win)( "failed to create the desktop event, status %#x\n", status );
+        inproc_desktop_event = 0;
+        return;
+    }
+    if (!(entry = get_user32_import( "win32u.dll", "NtUserCallNoParam" )))
+    {
+        ERR_(win)( "NtUserCallNoParam not found in the imports of user32 (%p)\n", user32_module );
+        NtSetEvent( inproc_desktop_event, NULL );
+        return;
+    }
+    status = NtCreateThreadEx( &thread, THREAD_ALL_ACCESS, NULL, NtCurrentProcess(), entry,
+                               (void *)(ULONG_PTR)NtUserCallNoParam_InprocDesktop, 0, 0, 0, 0, NULL );
+    if (status)
+    {
+        ERR_(win)( "failed to create the desktop thread, status %#x\n", status );
+        NtSetEvent( inproc_desktop_event, NULL );
+        return;
+    }
+    NtClose( thread );
+}
+
+/* make the desktop of this process, or wait for the thread that is making it */
+static void start_inproc_desktop(void)
+{
+    LARGE_INTEGER timeout;
+    HANDLE event;
+
+    /* the desktop's creator may ask for the desktop window while it creates it */
+    if (inproc_desktop_tid == GetCurrentThreadId()) return;
+
+    if (holds_loader_lock())
+    {
