+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_INPROC_SERVER_H
+#define __WINE_INPROC_SERVER_H
+
+/* A PS5 title cannot start a second program, so there the server is always a
+ * thread of the client. Other targets get the same configuration, for testing,
+ * by building the Unix side with -DWINE_INPROC_SERVER. */
+#if defined(__PROSPERO__) && !defined(WINE_INPROC_SERVER)
+# define WINE_INPROC_SERVER 1
+#endif
+
+#ifdef WINE_INPROC_SERVER
+
+struct wine_inproc_server_params
+{
+    int         client_fd;    /* the server's end of a socketpair( AF_UNIX, SOCK_STREAM ); it is
+                               * adopted as the process socket of the first (and only) client */
+    int         debug_level;  /* like wineserver -d<n> */
+    const char *config_dir;   /* absolute path of the prefix; it must exist */
+    const char *nls_dir;      /* directory holding l_intl.nls, or NULL to search the default places */
+    /* send a Unix signal to the client thread whose init_first_thread/init_thread request
+     * carried unix_tid. Must return 0 on success and -1 with errno set on failure (ESRCH
+     * when the thread is gone). Called on the server thread. */
+    int       (*thread_kill)( int unix_tid, int sig );
+};
+
+/* Run the server on the calling thread: initialize it, adopt params->client_fd as the
+ * first client and serve requests. It returns 0 once the last client process is gone and
+ * the registry has been saved, so the caller can pthread_join() it before exiting.
+ * An initialization failure is fatal for the whole process, as it is for wineserver:
+ * the message goes to stderr and exit(1) is called.
+ * Every asynchronous signal is blocked on the calling thread and no signal handler is
+ * installed: signal dispositions stay the client's. */
+extern int wine_server_inproc_main( const struct wine_inproc_server_params *params );
+
+/* Same, with the prefix taken from $WINEPREFIX (which must be set to an absolute path),
+ * no debug output, the default nls search and kill( getpid(), sig ) refused: without a
+ * thread_kill callback thread suspension and termination requests fail with an error. */
+extern int wine_server_thread_main( int client_fd );
+
+#endif  /* WINE_INPROC_SERVER */
+
+#endif  /* __WINE_INPROC_SERVER_H */
