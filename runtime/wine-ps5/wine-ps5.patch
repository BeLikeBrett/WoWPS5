+    inproc_threads[nb_inproc_threads].tid = tid;
+    inproc_threads[nb_inproc_threads++].pthread = pthread_self();
+    pthread_mutex_unlock( &inproc_threads_mutex );
+    pthread_sigmask( SIG_SETMASK, &sigset, NULL );
