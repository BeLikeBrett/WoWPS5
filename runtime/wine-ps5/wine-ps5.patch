+        struct inproc_thread *new_threads = realloc( inproc_threads, new_max * sizeof(*new_threads) );
+
+        if (!new_threads) fatal_error( "out of memory for the thread table\n" );
+        inproc_threads = new_threads;
+        max_inproc_threads = new_max;
