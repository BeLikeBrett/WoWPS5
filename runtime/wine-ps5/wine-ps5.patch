+/* Record the calling thread under the tid it is about to send to the server. The table
+ * is what lets the server signal a client thread with an exported function
+ * (pthread_kill) instead of a thread id system call. */
+static void inproc_register_thread( int tid )
+{
+    sigset_t sigset;
