+        NtClose( hkey );
+    }
+    else ERR( "failed to create the display device key %s\n", debugstr_wn( key, ptr - key ) );
+
+    if (!loaded)
+    {
+        /* the desktop window is about to be created without a driver: what
+         * load_display_driver() does when the desktop has none */
+        asciiz_to_unicode( driver_load_error, error );
