+#ifdef WINE_INPROC_SERVER
+
+/***********************************************************************
+ * The desktop of a single-process Wine
+ *
+ * Normally the first thread that needs the desktop window starts
+ * "explorer.exe /desktop", and that process loads the graphics driver, creates
+ * the desktop window and runs its message loop. With the server inside the
+ * only process there is no second process: the same work is done by one
+ * thread of this process, entirely on the Unix side.
+ *
+ * - The thread is an ordinary Win32 thread (it needs a TEB and a message
+ *   queue, and window procedures are called back on it). Its start address is
+ *   win32u.dll's NtUserCallNoParam syscall thunk and its argument is the
+ *   private code NtUserCallNoParam_InprocDesktop, so it enters win32u.so
+ *   directly and stays there. The thunk's address is read from user32's
+ *   import table; user32 passed its own base in NtUserInitializeClientPfnArrays.
+ * - It selects and loads the graphics driver, writes the registry key and the
+ *   window property that load_desktop_driver() reads in every other thread,
+ *   creates the desktop window and the HWND_MESSAGE parent, sizes and shows
+ *   the desktop, stores the display modes in the registry, and then pumps the
+ *   desktop window's messages for the life of the process.
+ * - The thread that asked waits until the desktop is ready, as it waits for
+ *   explorer to become idle in a normal build.
+ *
+ * A new thread cannot run while the loader lock is held, and loading the
+ * driver needs that lock. A thread that holds it when it needs the desktop (a
+ * window made in DllMain) therefore creates the desktop window itself, unless
+ * the desktop thread is already doing so. That thread then owns the desktop
+ * window: there is no dedicated message loop, and the desktop's messages are
+ * processed when the owner processes its own.
+ */
+
+static pthread_mutex_t inproc_desktop_mutex = PTHREAD_MUTEX_INITIALIZER;  /* held while the desktop is created */
+static HANDLE inproc_desktop_event;  /* set once the desktop thread has made the desktop, or cannot */
+static DWORD inproc_desktop_tid;     /* the thread that creates and owns the desktop window */
+
+/* the address a user32 import was bound to; dll in lower case */
+static void *get_user32_import( const char *dll, const char *name )
+{
+    const char *base = (const char *)user32_module;
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)base;
+    const IMAGE_NT_HEADERS *nt;
+    const IMAGE_DATA_DIRECTORY *dir;
+    const IMAGE_IMPORT_DESCRIPTOR *descr;
+
+    if (!base || dos->e_magic != IMAGE_DOS_SIGNATURE) return NULL;
+    nt = (const IMAGE_NT_HEADERS *)(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR_MAGIC) return NULL;
+    dir = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+    if (!dir->VirtualAddress || !dir->Size) return NULL;
+
+    for (descr = (const IMAGE_IMPORT_DESCRIPTOR *)(base + dir->VirtualAddress); descr->Name && descr->FirstThunk; descr++)
+    {
+        const IMAGE_THUNK_DATA *names, *thunks;
+        const char *module = base + descr->Name;
+        unsigned int i;
+
+        for (i = 0; dll[i] && (module[i] == dll[i] || module[i] == dll[i] - 'a' + 'A'); i++) /* nothing */;
+        if (dll[i] || module[i] || !descr->OriginalFirstThunk) continue;
+        names = (const IMAGE_THUNK_DATA *)(base + descr->OriginalFirstThunk);
+        thunks = (const IMAGE_THUNK_DATA *)(base + descr->FirstThunk);
+        for (i = 0; names[i].u1.AddressOfData; i++)
+        {
+            const IMAGE_IMPORT_BY_NAME *import;
+
+            if (IMAGE_SNAP_BY_ORDINAL( names[i].u1.Ordinal )) continue;
+            import = (const IMAGE_IMPORT_BY_NAME *)(base + names[i].u1.AddressOfData);
+            if (!strcmp( (const char *)import->Name, name )) return (void *)(ULONG_PTR)thunks[i].u1.Function;
+        }
+    }
+    return NULL;
+}
+
+static BOOL holds_loader_lock(void)
+{
+    const RTL_CRITICAL_SECTION *lock = NtCurrentTeb()->Peb->LoaderLock;
+    return lock && lock->OwningThread == ULongToHandle( GetCurrentThreadId() );
+}
