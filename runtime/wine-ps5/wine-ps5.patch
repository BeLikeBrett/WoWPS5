+static NTSTATUS get_state(void *args)
+{
+#ifdef __PROSPERO__
+    extern int wowps5_gamepad_state(unsigned, void *);
+    struct ps5_state_params *p = args;
+    p->result = wowps5_gamepad_state(p->index, p->state);
