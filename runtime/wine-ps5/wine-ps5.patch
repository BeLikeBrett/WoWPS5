+
+    if (config_dir[0] != '/') fatal_error( "the configuration directory '%s' is not an absolute path\n", config_dir );
+    if (stat( config_dir, &st ) == -1)
+    {
+        if (errno != ENOENT) fatal_perror( "cannot use directory %s", config_dir );
+        if (mkdir( config_dir, 0777 ) == -1) fatal_perror( "cannot create directory %s", config_dir );
