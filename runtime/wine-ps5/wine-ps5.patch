+/***********************************************************************
+ *           server_start_inproc
+ *
+ * Start the server as a thread of this process and return our end of the
+ * socket pair that replaces the connection to its master socket.
+ */
+static int server_start_inproc(void)
+{
+    int fds[2], done[2], ret;
+    char *nls_dir = NULL, *p;
+    pthread_attr_t attr;
+    pthread_t thread;
+    sigset_t sigset, old_sigset;
